#!/bin/bash
# Omarchy theme-set hook: rebuild Omarchy Cursor in the new theme's colors.
# Runs in the background so theme switching stays instant.

command -v omarchy-cursor >/dev/null || exit 0

log="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-cursor.log"
mkdir -p "$(dirname "$log")"
omarchy-cursor --apply >"$log" 2>&1 &
