#!/bin/bash
# Omarchy theme-set hook from Omarchy Pixel Cursors: rebuild the cursor in the
# new theme's colors. Runs in the background so theme switching stays instant.

bin="$HOME/.local/bin/omarchy-cursor"
[[ -x $bin ]] || exit 0

log="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-cursor.log"
mkdir -p "$(dirname "$log")"
(
  "$bin" --apply >"$log" 2>&1 ||
    notify-send -u critical "Omarchy Pixel Cursors" "Couldn't rebuild the cursor for this theme. Details in $log"
) &
